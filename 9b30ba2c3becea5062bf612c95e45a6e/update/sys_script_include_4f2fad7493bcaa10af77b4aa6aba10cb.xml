<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_script_include">
    <sys_script_include action="INSERT_OR_UPDATE">
        <access>package_private</access>
        <active>true</active>
        <api_name>x_snc_agenticdev.AiToolSetBacklogItemStateToDraft</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description>Sets the state of the given backlog item to "Draft / Need more info".</description>
        <mobile_callable>false</mobile_callable>
        <name>AiToolSetBacklogItemStateToDraft</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[function AiToolSetBacklogItemStateToDraft(vBacklogItem)
{
	var grBacklogItem = x_snc_agile.GetBacklogItemRecord(vBacklogItem);
	if (grBacklogItem == false)
	{
		return { message: 'Backlog item not found.' };
	}

	grBacklogItem.state = x_snc_agile.GetBacklogItemState('draft');
	grBacklogItem.update();

	return { message: 'Backlog item state is set to "Draft / Need more info".' };
}]]></script>
